# Datos del LDAP de laboratorio. Todas las claves son ficticias.
dn: dc=monitoreo,dc=lab
objectClass: top
objectClass: dcObject
objectClass: organization
o: monitoreo
dc: monitoreo

dn: ou=people,dc=monitoreo,dc=lab
objectClass: organizationalUnit
ou: people

dn: ou=groups,dc=monitoreo,dc=lab
objectClass: organizationalUnit
ou: groups

dn: ou=devices,dc=monitoreo,dc=lab
objectClass: organizationalUnit
ou: devices

dn: uid=admin1,ou=people,dc=monitoreo,dc=lab
objectClass: inetOrgPerson
uid: admin1
cn: Administrador Uno
sn: Uno
userPassword: clave-admin-lab1

dn: uid=operador1,ou=people,dc=monitoreo,dc=lab
objectClass: inetOrgPerson
uid: operador1
cn: Operador Uno
sn: Uno
userPassword: clave-operador-lab1

